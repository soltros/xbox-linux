+
+xbox_vk_presenter *xbox_vk_presenter_create(SDL_Window *window, int vsync);
+int xbox_vk_presenter_draw(xbox_vk_presenter *presenter, const uint8_t *pixels,
+                           uint32_t bpp, uint32_t pitch);
