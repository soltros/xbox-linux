--- a/src/video/fb_present_vulkan.c
+++ b/src/video/fb_present_vulkan.c
@@ -0,0 +1,427 @@
+#include "fb_present_vulkan.h"
+
+#include <SDL_vulkan.h>
+#include <vulkan/vulkan.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FB_WIDTH 640u
+#define FB_HEIGHT 480u
+
+struct xbox_vk_presenter {
+    VkInstance instance;
+    VkSurfaceKHR surface;
+    VkPhysicalDevice physical;
+    VkDevice device;
+    VkQueue queue;
+    uint32_t queue_family;
+    VkSwapchainKHR swapchain;
+    VkFormat format;
+    VkColorSpaceKHR color_space;
+    VkExtent2D extent;
+    VkImage *images;
+    VkImageLayout *layouts;
+    uint32_t image_count;
+    VkBuffer staging;
+    VkDeviceMemory staging_memory;
+    uint8_t *mapped;
+    VkImage source_image;
+    VkDeviceMemory source_memory;
+    VkImageLayout source_layout;
+    VkCommandPool command_pool;
+    VkCommandBuffer command;
+    VkSemaphore acquired;
+    VkSemaphore complete;
+    VkFence fence;
+};
+
+static int vk_ok(VkResult result, const char *operation)
+{
+    if (result == VK_SUCCESS)
+        return 1;
+    fprintf(stderr, "  [VULKAN] %s failed (%d)\n", operation, (int)result);
+    return 0;
+}
+
+static uint32_t memory_type(VkPhysicalDevice physical, uint32_t bits,
+                            VkMemoryPropertyFlags properties)
+{
+    VkPhysicalDeviceMemoryProperties p;
+    uint32_t i;
+    vkGetPhysicalDeviceMemoryProperties(physical, &p);
+    for (i = 0; i < p.memoryTypeCount; i++)
+        if ((bits & (1u << i))
+            && (p.memoryTypes[i].propertyFlags & properties) == properties)
+            return i;
+    return UINT32_MAX;
+}
+
+void xbox_vk_presenter_destroy(xbox_vk_presenter *p)
+{
+    if (!p)
+        return;
+    if (p->device)
+        vkDeviceWaitIdle(p->device);
+    if (p->device && p->mapped)
+        vkUnmapMemory(p->device, p->staging_memory);
+    if (p->device && p->fence) vkDestroyFence(p->device, p->fence, NULL);
+    if (p->device && p->acquired) vkDestroySemaphore(p->device, p->acquired, NULL);
+    if (p->device && p->complete) vkDestroySemaphore(p->device, p->complete, NULL);
+    if (p->device && p->command_pool) vkDestroyCommandPool(p->device, p->command_pool, NULL);
+    if (p->device && p->source_image) vkDestroyImage(p->device, p->source_image, NULL);
+    if (p->device && p->source_memory) vkFreeMemory(p->device, p->source_memory, NULL);
+    if (p->device && p->staging) vkDestroyBuffer(p->device, p->staging, NULL);
+    if (p->device && p->staging_memory) vkFreeMemory(p->device, p->staging_memory, NULL);
+    if (p->device && p->swapchain) vkDestroySwapchainKHR(p->device, p->swapchain, NULL);
+    if (p->device) vkDestroyDevice(p->device, NULL);
+    if (p->surface) vkDestroySurfaceKHR(p->instance, p->surface, NULL);
+    if (p->instance) vkDestroyInstance(p->instance, NULL);
+    free(p->images);
+    free(p->layouts);
+    free(p);
+}
+
+xbox_vk_presenter *xbox_vk_presenter_create(SDL_Window *window, int vsync)
+{
+    xbox_vk_presenter *p = calloc(1, sizeof *p);
+    VkApplicationInfo app = { .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+        .pApplicationName = "Xbox Linux", .applicationVersion = 1,
+        .pEngineName = "xboxrecomp", .engineVersion = 1,
+        .apiVersion = VK_API_VERSION_1_0 };
+    VkInstanceCreateInfo ici = { .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+        .pApplicationInfo = &app };
+    const char **extensions = NULL;
+    unsigned ext_count = 0;
+    VkPhysicalDevice *devices = NULL;
+    uint32_t device_count = 0, i, q;
+    VkSurfaceCapabilitiesKHR caps;
+    VkSurfaceFormatKHR *formats = NULL;
+    uint32_t format_count = 0;
+    VkPresentModeKHR *modes = NULL;
+    uint32_t mode_count = 0;
+    VkSwapchainCreateInfoKHR sci = { .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    VkDeviceQueueCreateInfo qci = { .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+    VkDeviceCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
+    const char *device_extensions[] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+    float priority = 1.0f;
+    int drawable_w, drawable_h;
+
+    if (!p)
+        return NULL;
+    if (!SDL_Vulkan_GetInstanceExtensions(window, &ext_count, NULL)
+        || !ext_count) {
+        fprintf(stderr, "  [VULKAN] SDL instance extensions unavailable: %s\n", SDL_GetError());
+        goto fail;
+    }
+    extensions = calloc(ext_count, sizeof *extensions);
+    if (!extensions || !SDL_Vulkan_GetInstanceExtensions(window, &ext_count, extensions))
+        goto fail;
+    ici.enabledExtensionCount = ext_count;
+    ici.ppEnabledExtensionNames = extensions;
+    if (!vk_ok(vkCreateInstance(&ici, NULL, &p->instance), "vkCreateInstance")) goto fail;
+    if (!SDL_Vulkan_CreateSurface(window, p->instance, &p->surface)) {
+        fprintf(stderr, "  [VULKAN] SDL surface creation failed: %s\n", SDL_GetError());
+        goto fail;
+    }
+    if (!vk_ok(vkEnumeratePhysicalDevices(p->instance, &device_count, NULL),
+               "vkEnumeratePhysicalDevices") || !device_count) goto fail;
+    devices = calloc(device_count, sizeof *devices);
+    if (!devices || !vk_ok(vkEnumeratePhysicalDevices(p->instance, &device_count, devices),
+                           "vkEnumeratePhysicalDevices")) goto fail;
+
+    for (i = 0; i < device_count && !p->physical; i++) {
+        uint32_t qc = 0;
+        VkQueueFamilyProperties *queues;
+        vkGetPhysicalDeviceQueueFamilyProperties(devices[i], &qc, NULL);
+        queues = calloc(qc, sizeof *queues);
+        if (!queues) goto fail;
+        vkGetPhysicalDeviceQueueFamilyProperties(devices[i], &qc, queues);
+        for (q = 0; q < qc; q++) {
+            VkBool32 present = VK_FALSE;
+            vkGetPhysicalDeviceSurfaceSupportKHR(devices[i], q, p->surface, &present);
+            if ((queues[q].queueFlags & VK_QUEUE_GRAPHICS_BIT) && present) {
+                p->physical = devices[i];
+                p->queue_family = q;
+                break;
+            }
+        }
+        free(queues);
+    }
+    free(devices); devices = NULL;
+    if (!p->physical) {
+        fprintf(stderr, "  [VULKAN] no graphics/presentation queue found\n");
+        goto fail;
+    }
+    if (!vk_ok(vkGetPhysicalDeviceSurfaceCapabilitiesKHR(p->physical, p->surface, &caps),
+               "surface capabilities") || !(caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_DST_BIT)) {
+        fprintf(stderr, "  [VULKAN] swapchain images cannot receive framebuffer uploads\n");
+        goto fail;
+    }
+    if (!vk_ok(vkGetPhysicalDeviceSurfaceFormatsKHR(p->physical, p->surface, &format_count, NULL),
+               "surface formats") || !format_count) goto fail;
+    formats = calloc(format_count, sizeof *formats);
+    if (!formats || !vk_ok(vkGetPhysicalDeviceSurfaceFormatsKHR(p->physical, p->surface,
+                                         &format_count, formats), "surface formats")) goto fail;
+    p->format = VK_FORMAT_UNDEFINED;
+    for (i = 0; i < format_count; i++) {
+        if (formats[i].format == VK_FORMAT_UNDEFINED) {
+            p->format = VK_FORMAT_B8G8R8A8_UNORM;
+            p->color_space = formats[i].colorSpace;
+            break;
+        }
+        if (formats[i].format == VK_FORMAT_B8G8R8A8_UNORM
+            || formats[i].format == VK_FORMAT_R8G8B8A8_UNORM) {
+            p->format = formats[i].format;
+            p->color_space = formats[i].colorSpace;
+            break;
+        }
+    }
+    free(formats); formats = NULL;
+    if (p->format == VK_FORMAT_UNDEFINED) {
+        fprintf(stderr, "  [VULKAN] no supported 8-bit swapchain format\n");
+        goto fail;
+    }
+    {
+        VkFormatProperties fp;
+        vkGetPhysicalDeviceFormatProperties(p->physical, p->format, &fp);
+        if ((fp.optimalTilingFeatures & (VK_FORMAT_FEATURE_BLIT_SRC_BIT
+                                         | VK_FORMAT_FEATURE_BLIT_DST_BIT))
+                != (VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_BLIT_DST_BIT)) {
+            fprintf(stderr, "  [VULKAN] swapchain format cannot be scaled with an image blit\n");
+            goto fail;
+        }
+    }
+    if (!vk_ok(vkGetPhysicalDeviceSurfacePresentModesKHR(p->physical, p->surface,
+                                                         &mode_count, NULL), "present modes")) goto fail;
+    modes = calloc(mode_count, sizeof *modes);
+    if (!modes || !vk_ok(vkGetPhysicalDeviceSurfacePresentModesKHR(p->physical, p->surface,
+                                             &mode_count, modes), "present modes")) goto fail;
+    sci.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+    if (!vsync)
+        for (i = 0; i < mode_count; i++)
+            if (modes[i] == VK_PRESENT_MODE_IMMEDIATE_KHR) sci.presentMode = modes[i];
+    free(modes); modes = NULL;
+
+    SDL_Vulkan_GetDrawableSize(window, &drawable_w, &drawable_h);
+    p->extent = caps.currentExtent.width != UINT32_MAX ? caps.currentExtent
+        : (VkExtent2D){ (uint32_t)drawable_w, (uint32_t)drawable_h };
+    if (p->extent.width < caps.minImageExtent.width) p->extent.width = caps.minImageExtent.width;
+    if (p->extent.height < caps.minImageExtent.height) p->extent.height = caps.minImageExtent.height;
+    if (p->extent.width > caps.maxImageExtent.width) p->extent.width = caps.maxImageExtent.width;
+    if (p->extent.height > caps.maxImageExtent.height) p->extent.height = caps.maxImageExtent.height;
+    if (!p->extent.width || !p->extent.height) goto fail;
+    sci.surface = p->surface;
+    sci.minImageCount = caps.minImageCount + 1;
+    if (caps.maxImageCount && sci.minImageCount > caps.maxImageCount) sci.minImageCount = caps.maxImageCount;
+    sci.imageFormat = p->format;
+    sci.imageColorSpace = p->color_space;
+    sci.imageExtent = p->extent;
+    sci.imageArrayLayers = 1;
+    sci.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    sci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    sci.preTransform = caps.currentTransform;
+    sci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    if (!(caps.supportedCompositeAlpha & sci.compositeAlpha)) {
+        for (i = 0; i < 4; i++)
+            if (caps.supportedCompositeAlpha & (1u << i)) {
+                sci.compositeAlpha = (VkCompositeAlphaFlagBitsKHR)(1u << i);
+                break;
+            }
+    }
+    sci.clipped = VK_TRUE;
+    qci.queueFamilyIndex = p->queue_family; qci.queueCount = 1; qci.pQueuePriorities = &priority;
+    dci.queueCreateInfoCount = 1; dci.pQueueCreateInfos = &qci;
+    dci.enabledExtensionCount = 1; dci.ppEnabledExtensionNames = device_extensions;
+    if (!vk_ok(vkCreateDevice(p->physical, &dci, NULL, &p->device), "vkCreateDevice")) goto fail;
+    vkGetDeviceQueue(p->device, p->queue_family, 0, &p->queue);
+    if (!vk_ok(vkCreateSwapchainKHR(p->device, &sci, NULL, &p->swapchain), "vkCreateSwapchainKHR")) goto fail;
+    if (!vk_ok(vkGetSwapchainImagesKHR(p->device, p->swapchain, &p->image_count, NULL), "swapchain images")) goto fail;
+    p->images = calloc(p->image_count, sizeof *p->images);
+    p->layouts = calloc(p->image_count, sizeof *p->layouts);
+    if (!p->images || !p->layouts || !vk_ok(vkGetSwapchainImagesKHR(p->device, p->swapchain,
+                                                 &p->image_count, p->images), "swapchain images")) goto fail;
+    {
+        VkBufferCreateInfo bi = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .size = (VkDeviceSize)FB_WIDTH * FB_HEIGHT * 4,
+            .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT, .sharingMode = VK_SHARING_MODE_EXCLUSIVE };
+        VkMemoryRequirements req;
+        VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        uint32_t mt;
+        if (!vk_ok(vkCreateBuffer(p->device, &bi, NULL, &p->staging), "staging buffer")) goto fail;
+        vkGetBufferMemoryRequirements(p->device, p->staging, &req);
+        mt = memory_type(p->physical, req.memoryTypeBits,
+                         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+        if (mt == UINT32_MAX) { fprintf(stderr, "  [VULKAN] no coherent host-visible memory\n"); goto fail; }
+        ai.allocationSize = req.size; ai.memoryTypeIndex = mt;
+        if (!vk_ok(vkAllocateMemory(p->device, &ai, NULL, &p->staging_memory), "staging memory")
+            || !vk_ok(vkBindBufferMemory(p->device, p->staging, p->staging_memory, 0), "bind staging")
+            || !vk_ok(vkMapMemory(p->device, p->staging_memory, 0, bi.size, 0, (void **)&p->mapped), "map staging")) goto fail;
+    }
+    {
+        VkImageCreateInfo ii = { .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+            .imageType = VK_IMAGE_TYPE_2D, .format = p->format,
+            .extent = { FB_WIDTH, FB_HEIGHT, 1 }, .mipLevels = 1, .arrayLayers = 1,
+            .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE, .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED };
+        VkMemoryRequirements req;
+        VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+        uint32_t mt;
+        if (!vk_ok(vkCreateImage(p->device, &ii, NULL, &p->source_image), "source image")) goto fail;
+        vkGetImageMemoryRequirements(p->device, p->source_image, &req);
+        mt = memory_type(p->physical, req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (mt == UINT32_MAX) {
+            fprintf(stderr, "  [VULKAN] no device-local memory for framebuffer image\n");
+            goto fail;
+        }
+        ai.allocationSize = req.size; ai.memoryTypeIndex = mt;
+        if (!vk_ok(vkAllocateMemory(p->device, &ai, NULL, &p->source_memory), "source image memory")
+            || !vk_ok(vkBindImageMemory(p->device, p->source_image, p->source_memory, 0), "bind source image")) goto fail;
+    }
+    {
+        VkCommandPoolCreateInfo pi = { .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+            .queueFamilyIndex = p->queue_family, .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT };
+        VkCommandBufferAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool = VK_NULL_HANDLE, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1 };
+        VkSemaphoreCreateInfo si = { .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+        VkFenceCreateInfo fi = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+            .flags = VK_FENCE_CREATE_SIGNALED_BIT };
+        if (!vk_ok(vkCreateCommandPool(p->device, &pi, NULL, &p->command_pool), "command pool")) goto fail;
+        ai.commandPool = p->command_pool;
+        if (!vk_ok(vkAllocateCommandBuffers(p->device, &ai, &p->command), "command buffer")
+            || !vk_ok(vkCreateSemaphore(p->device, &si, NULL, &p->acquired), "acquire semaphore")
+            || !vk_ok(vkCreateSemaphore(p->device, &si, NULL, &p->complete), "present semaphore")
+            || !vk_ok(vkCreateFence(p->device, &fi, NULL, &p->fence), "frame fence")) goto fail;
+    }
+    {
+        VkPhysicalDeviceProperties props;
+        vkGetPhysicalDeviceProperties(p->physical, &props);
+        fprintf(stderr, "  [VULKAN] presenter: %s (%ux%u, framebuffer upload)\n",
+                props.deviceName, p->extent.width, p->extent.height);
+    }
+    free(extensions);
+    return p;
+fail:
+    free(devices); free(formats); free(modes); free(extensions);
+    xbox_vk_presenter_destroy(p);
+    return NULL;
+}
+
+int xbox_vk_presenter_draw(xbox_vk_presenter *p, const uint8_t *pixels,
+                           uint32_t bpp, uint32_t pitch)
+{
+    uint32_t x, y, image_index;
+    VkResult r;
+    VkCommandBufferBeginInfo begin = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+        .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT };
+    VkImageMemoryBarrier to_copy = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT };
+    VkImageMemoryBarrier to_present = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT };
+    VkImageMemoryBarrier source_to_copy = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT };
+    VkImageMemoryBarrier source_to_blit = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT };
+    VkBufferImageCopy copy = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .imageExtent = { FB_WIDTH, FB_HEIGHT, 1 } };
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_TRANSFER_BIT;
+    VkSubmitInfo submit = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    VkPresentInfoKHR present = { .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+
+    if (!p || !pixels || (bpp != 2 && bpp != 4) || pitch < FB_WIDTH * bpp)
+        return 0;
+    submit.waitSemaphoreCount = 1;
+    submit.pWaitSemaphores = &p->acquired;
+    submit.pWaitDstStageMask = &wait_stage;
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &p->command;
+    submit.signalSemaphoreCount = 1;
+    submit.pSignalSemaphores = &p->complete;
+    present.waitSemaphoreCount = 1;
+    present.pWaitSemaphores = &p->complete;
+    present.swapchainCount = 1;
+    present.pSwapchains = &p->swapchain;
+    present.pImageIndices = &image_index;
+    for (y = 0; y < FB_HEIGHT; y++) {
+        for (x = 0; x < FB_WIDTH; x++) {
+            uint8_t red, green, blue, *d = p->mapped + ((size_t)y * FB_WIDTH + x) * 4;
+            if (bpp == 4) {
+                uint32_t v; memcpy(&v, pixels + (size_t)y * pitch + (size_t)x * 4, 4);
+                red = (uint8_t)(v >> 16); green = (uint8_t)(v >> 8); blue = (uint8_t)v;
+            } else {
+                uint16_t v; memcpy(&v, pixels + (size_t)y * pitch + (size_t)x * 2, 2);
+                red = (uint8_t)(((v >> 11) & 31) * 255 / 31);
+                green = (uint8_t)(((v >> 5) & 63) * 255 / 63);
+                blue = (uint8_t)((v & 31) * 255 / 31);
+            }
+            if (p->format == VK_FORMAT_B8G8R8A8_UNORM) { d[0] = blue; d[1] = green; d[2] = red; }
+            else { d[0] = red; d[1] = green; d[2] = blue; }
+            d[3] = 255;
+        }
+    }
+    if (!vk_ok(vkWaitForFences(p->device, 1, &p->fence, VK_TRUE, UINT64_MAX), "wait frame")) return 0;
+    r = vkAcquireNextImageKHR(p->device, p->swapchain, UINT64_MAX, p->acquired, VK_NULL_HANDLE, &image_index);
+    if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) { vk_ok(r, "acquire image"); return 0; }
+    if (!vk_ok(vkResetFences(p->device, 1, &p->fence), "reset frame fence")
+        || !vk_ok(vkResetCommandBuffer(p->command, 0), "reset command buffer")
+        || !vk_ok(vkBeginCommandBuffer(p->command, &begin), "begin command buffer")) return 0;
+    to_copy.image = p->images[image_index];
+    to_copy.oldLayout = p->layouts[image_index] ? VK_IMAGE_LAYOUT_PRESENT_SRC_KHR : VK_IMAGE_LAYOUT_UNDEFINED;
+    to_copy.srcAccessMask = 0;
+    source_to_copy.image = p->source_image;
+    source_to_copy.oldLayout = p->source_layout ? VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL
+                                                 : VK_IMAGE_LAYOUT_UNDEFINED;
+    source_to_copy.srcAccessMask = p->source_layout ? VK_ACCESS_TRANSFER_READ_BIT : 0;
+    vkCmdPipelineBarrier(p->command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &to_copy);
+    vkCmdPipelineBarrier(p->command,
+        p->source_layout ? VK_PIPELINE_STAGE_TRANSFER_BIT : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &source_to_copy);
+    copy.bufferOffset = 0; copy.bufferRowLength = 0; copy.bufferImageHeight = 0;
+    copy.imageOffset = (VkOffset3D){0, 0, 0};
+    vkCmdCopyBufferToImage(p->command, p->staging, p->source_image,
+                           VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    source_to_blit.image = p->source_image;
+    vkCmdPipelineBarrier(p->command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &source_to_blit);
+    {
+        VkImageBlit blit = {
+            .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .srcOffsets = { { 0, 0, 0 }, { FB_WIDTH, FB_HEIGHT, 1 } },
+            .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .dstOffsets = { { 0, 0, 0 }, { (int32_t)p->extent.width, (int32_t)p->extent.height, 1 } }
+        };
+        vkCmdBlitImage(p->command, p->source_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       p->images[image_index], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                       1, &blit, VK_FILTER_NEAREST);
+    }
+    to_present.image = p->images[image_index];
+    vkCmdPipelineBarrier(p->command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL, 0, NULL, 1, &to_present);
+    if (!vk_ok(vkEndCommandBuffer(p->command), "end command buffer")
+        || !vk_ok(vkQueueSubmit(p->queue, 1, &submit, p->fence), "submit frame")) return 0;
+    p->source_layout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    p->layouts[image_index] = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+    r = vkQueuePresentKHR(p->queue, &present);
+    if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR) { vk_ok(r, "present frame"); return 0; }
+    /* One pair of binary semaphores is reused; wait until presentation has
+     * consumed the signal before the next submission re-signals it. */
+    if (!vk_ok(vkQueueWaitIdle(p->queue), "wait presentation queue")) return 0;
+    return 1;
+}
