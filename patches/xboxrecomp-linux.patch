+/* Save the guest image the SDL window is presenting. Keep the format simple
+ * so diagnostic bundles need no image library. RGB888 pixels are 0x00RRGGBB;
+ * RGB565 is expanded to 8-bit channels here. */
+static void dump_window_bmp(const char *path, const uint8_t *px,
+                            uint32_t bpp, uint32_t pitch)
+{
+    uint32_t row = (FB_W * 3u + 3u) & ~3u;
+    uint32_t image = row * FB_H, total = 54u + image, y, x;
+    uint8_t hdr[54], *line;
+    FILE *f;
+
+    if (!path || !*path || !px || (bpp != 2 && bpp != 4))
+        return;
+    f = fopen(path, "wb");
+    if (!f)
+        return;
+    memset(hdr, 0, sizeof hdr);
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &total, 4);
+    hdr[10] = 54; hdr[14] = 40;
+    memcpy(hdr + 18, &(uint32_t){FB_W}, 4);
+    memcpy(hdr + 22, &(uint32_t){FB_H}, 4);
+    hdr[26] = 1; hdr[28] = 24;
+    memcpy(hdr + 34, &image, 4);
+    if (fwrite(hdr, 1, sizeof hdr, f) != sizeof hdr) {
+        fclose(f);
+        return;
+    }
+    line = (uint8_t *)calloc(1, row);
+    if (!line) {
+        fclose(f);
+        return;
+    }
+    for (y = 0; y < FB_H; y++) {
+        const uint8_t *src = px + (size_t)(FB_H - 1 - y) * pitch;
+        for (x = 0; x < FB_W; x++) {
+            uint8_t r, g, b;
+            if (bpp == 4) {
+                uint32_t v;
+                memcpy(&v, src + (size_t)x * 4, 4);
+                r = (uint8_t)(v >> 16);
+                g = (uint8_t)(v >> 8);
+                b = (uint8_t)v;
+            } else {
+                uint16_t v;
+                memcpy(&v, src + (size_t)x * 2, 2);
+                r = (uint8_t)(((v >> 11) & 0x1F) * 255u / 31u);
+                g = (uint8_t)(((v >> 5) & 0x3F) * 255u / 63u);
+                b = (uint8_t)((v & 0x1F) * 255u / 31u);
+            }
+            line[x * 3 + 0] = b;
+            line[x * 3 + 1] = g;
+            line[x * 3 + 2] = r;
+        }
+        if (fwrite(line, 1, row, f) != row)
+            break;
+    }
+    free(line);
+    fclose(f);
+}
