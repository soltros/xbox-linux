     return xbox_translate_path(xbox_path, host_path, (DWORD)n) ? 1 : 0;
 }
 
+/* Xbox volumes are case-insensitive while Linux paths are not. Resolve each
+ * existing path component using ASCII case folding, leaving the first missing
+ * component (and its suffix) untouched so create/open-if still works. */
+static void posix_casefold_existing_path(char *path, size_t capacity)
+{
+    char prefix[MAX_PATH];
+    size_t used = 0;
+    const char *p = path;
+    if (*p == '/') { prefix[used++] = '/'; p++; }
+    prefix[used] = '\0';
+    while (*p) {
+        const char *start;
+        size_t length;
+        DIR *dir;
+        struct dirent *entry;
+        char component[NAME_MAX + 1];
+        int found = 0;
+        while (*p == '/') p++;
+        if (!*p) break;
+        start = p;
+        while (*p && *p != '/') p++;
+        length = (size_t)(p - start);
+        if (length > NAME_MAX || used + length + 2 >= sizeof(prefix)) return;
+        memcpy(component, start, length); component[length] = '\0';
+        dir = opendir(used ? prefix : ".");
+        if (!dir) return;
+        while ((entry = readdir(dir)) != NULL) {
+            if (strcasecmp(entry->d_name, component) == 0) {
+                size_t match_len = strlen(entry->d_name);
+                if (used + match_len + 2 < sizeof(prefix)) {
+                    if (used && prefix[used - 1] != '/') prefix[used++] = '/';
+                    memcpy(prefix + used, entry->d_name, match_len);
+                    used += match_len; prefix[used] = '\0';
+                    found = 1;
+                }
+                break;
+            }
+        }
+        closedir(dir);
+        if (!found) return;
+    }
+    if (strlen(prefix) < capacity) strcpy(path, prefix);
+}
